# Скопируйте в .env и замените все значения-заглушки.
# .env не коммитится и не попадает в Docker-образ.

# --- Приложение ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Ключ шифрования серверных секретов (токены агентов, TOTP-секреты).
# В production обязателен, минимум 32 символа. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RC_MASTER_KEY=dev-only-change-me-0123456789abcdef

# Публичный адрес панели. Нужен для ссылок, PWA, QR и Web Push.
RC_PUBLIC_URL=http://localhost:3000
# auto — secure-cookie включаются автоматически для HTTPS.
RC_COOKIE_SECURE=auto

# Первый администратор создаётся при старте, если в базе ещё нет пользователей.
# RC_BOOTSTRAP_EMAIL=admin@example.com
# RC_BOOTSTRAP_PASSWORD=change-me-please

# Применять миграции при старте процесса (в production оставьте false:
# миграции запускаются отдельным шагом/контейнером).
MIGRATE_ON_START=false

# Доверять X-Forwarded-* только если приложение стоит за доверенным прокси
# (например, Caddy). Напрямую из интернета оставляйте false.
TRUST_PROXY=false

# Путь к собранной SPA. По умолчанию server ищет web/dist рядом с собой.
# WEB_DIST=./web/dist

# Каталог SQL-миграций. По умолчанию server/migrations.
# MIGRATIONS_DIR=./server/migrations

# --- PostgreSQL ---
# Для запуска сервера на хосте (npm run dev) при поднятом docker compose up -d db.
DATABASE_URL=postgres://router_control:router_control_dev@127.0.0.1:5432/router_control

# Используются контейнером db и для сборки DATABASE_URL внутри compose.
POSTGRES_DB=router_control
POSTGRES_USER=router_control
POSTGRES_PASSWORD=router_control_dev
POSTGRES_PORT=5432

# --- Публикация приложения ---
# По умолчанию порт приложения доступен только на loopback.
RC_BIND_ADDR=127.0.0.1
RC_PORT=3000

# --- Необязательный reverse proxy (профиль proxy) ---
# RC_DOMAIN=rc.example.com
# RC_TLS_MODE=internal
# Для публичного домена укажите e-mail для ACME:
# RC_TLS_MODE=admin@example.com

# --- Web Push (необязательно) ---
# Ключи VAPID. Если не заданы, сервер создаст пару в /app/data/vapid.json
# при первом запуске. Указывать вручную нужно только при переносе данных
# без каталога /app/data или при нескольких репликах приложения.
# Сгенерировать: node -e "console.log(require('web-push').generateVAPIDKeys())"
# RC_VAPID_PUBLIC_KEY=
# RC_VAPID_PRIVATE_KEY=
# RC_VAPID_SUBJECT=mailto:admin@example.com

# --- Резервные копии (профиль backup) ---
# Пароль шифрования дампов. Хранить отдельно от BACKUP_OFFSITE_CMD.
# Минимум 20 символов, лучше сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# BACKUP_PASSPHRASE=change-me-backup-passphrase
# BACKUP_RETENTION_DAYS=14
# Необязательная команда отправки offsite. Получает путь в $BACKUP_FILE.
# Пример: rclone copy "$BACKUP_FILE" remote:routx-backups/
# BACKUP_OFFSITE_CMD=
