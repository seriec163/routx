{
	"luci-app-janusnew": {
		"description": "Статус агента JanusNew",
		"read": {
			"file": {
				"/var/run/janusnew/status.json": [ "read" ]
			}
		},
		"write": {
			"file": {
				"/etc/init.d/janusnew restart": [ "exec" ],
				"/usr/bin/janusnew rotate": [ "exec" ],
				"/usr/bin/janusnew mobile-qr": [ "exec" ],
				"/usr/bin/janusnew mobile-devices": [ "exec" ],
				"/usr/bin/janusnew mobile-revoke *": [ "exec" ]
			}
		}
	}
}
