#!/bin/sh
# RoutX helper: run command with clean env and timeouts.
# Usage: routx-agent-exec <timeout> <stdout> <stderr> -- <argv...>
TIMEOUT="$1"
OUT="$2"
ERR="$3"
shift 3
[ "$1" = "--" ] && shift
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root

# coreutils-timeout есть не в каждой прошивке. Без него агент не должен
# терять возможность выполнять команды: используем shell-сторожевой таймер.
if command -v timeout >/dev/null 2>&1; then
	exec timeout "$TIMEOUT" "$@" >"$OUT" 2>"$ERR"
fi

"$@" >"$OUT" 2>"$ERR" &
PID=$!
(
	sleep "$TIMEOUT"
	kill -TERM "$PID" 2>/dev/null
	sleep 1
	kill -KILL "$PID" 2>/dev/null
) &
WATCHDOG=$!
trap 'kill "$PID" 2>/dev/null; kill "$WATCHDOG" 2>/dev/null; exit 143' INT TERM

wait "$PID"
RC=$?
kill "$WATCHDOG" 2>/dev/null
wait "$WATCHDOG" 2>/dev/null
exit "$RC"
