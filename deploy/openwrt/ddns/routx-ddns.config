config ddns 'main'
	option enabled '1'
	option domain 'routx.duckdns.org'
	option interface 'wan'
	# Проверка IP каждые 5 минут.
	option check_interval '300'
	# Повтор при ошибке через минуту.
	option retry_interval '60'
	# Принудительное обновление раз в 72 часа, даже если IP не менялся:
	# DuckDNS удаляет домены без активности.
	option force_interval '86400'
	# Токен лежит отдельно, режим 0600.
	option token_file '/etc/routx-ddns/token'
