{
  "name": "routx",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Централизованное управление VPN и прокси на роутерах OpenWrt: Tachyon, Forkop, Prokop, Podkop",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @routx/server",
    "dev:web": "npm run dev -w @routx/web",
    "build": "npm run build -w @routx/server && npm run build -w @routx/web",
    "start": "npm run start -w @routx/server",
    "typecheck": "npm run typecheck -w @routx/server && npm run typecheck -w @routx/web",
    "test": "npm run test -w @routx/server",
    "db:migrate": "npm run db:migrate -w @routx/server",
    "bootstrap": "npm run bootstrap -w @routx/server --",
    "password-reset": "npm run password-reset -w @routx/server --",
    "rotate-master-key": "npm run rotate-master-key -w @routx/server --",
    "agent:build": "node agent/build.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
