{
  "name": "@routx/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "db:migrate": "tsx src/migrate-cli.ts",
    "bootstrap": "tsx src/cli/bootstrap.ts",
    "password-reset": "tsx src/cli/password-reset.ts",
    "rotate-master-key": "tsx src/cli/rotate-master-key.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@node-rs/argon2": "^2.2.2",
    "@simplewebauthn/server": "^14.1.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
