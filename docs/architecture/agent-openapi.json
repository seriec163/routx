{
  "openapi": "3.1.0",
  "info": {
    "title": "RoutX Agent API",
    "version": "1",
    "description": "Протокол агента RoutX. Запросы, кроме bind, подписываются токеном агента: Authorization: Bearer <token>, X-Rc-Timestamp (секунды), X-Rc-Nonce (16–128 символов), X-Rc-Signature = HMAC-SHA256(token, method + \"\\n\" + path + \"\\n\" + timestamp + \"\\n\" + nonce + \"\\n\" + sha256(body))."
  },
  "servers": [
    {
      "url": "{baseUrl}",
      "variables": {
        "baseUrl": {
          "default": "https://routx.example.com"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "agentToken": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/agent/v1/bind": {
      "post": {
        "summary": "Привязать роутер по одноразовому токену",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 64
                  },
                  "product": {
                    "type": "string",
                    "enum": [
                      "forkop",
                      "prokop",
                      "podkop",
                      "tachyon",
                      "unknown",
                      "conflict"
                    ]
                  },
                  "agent_version": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "hardware": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "token"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Токен агента и параметры опроса",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "router_id",
                    "agent_token",
                    "server_url"
                  ],
                  "properties": {
                    "router_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "agent_token": {
                      "type": "string"
                    },
                    "server_url": {
                      "type": "string"
                    },
                    "poll_interval_seconds": {
                      "type": "integer"
                    },
                    "poll_hold_seconds": {
                      "type": "integer"
                    },
                    "require_signature": {
                      "type": "boolean"
                    },
                    "server_time": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "protocol": {
                      "type": "string",
                      "const": "v1"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Токен недействителен или продукт не совпал"
          }
        }
      }
    },
    "/agent/v1/probe": {
      "post": {
        "summary": "Передать состояние роутера",
        "security": [
          {
            "agentToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "agent_version": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "product": {
                    "type": "string",
                    "enum": [
                      "forkop",
                      "prokop",
                      "podkop",
                      "tachyon",
                      "unknown",
                      "conflict"
                    ]
                  },
                  "product_version": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 60
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "conflict": {
                    "type": "boolean"
                  },
                  "manifest_version": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "openwrt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 60
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "arch": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 60
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "model": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 120
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sing_box_version": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 60
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sing_box_variant": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 40
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "platform_state": {
                    "type": "string",
                    "enum": [
                      "ok",
                      "unsupported",
                      "conflict"
                    ]
                  },
                  "installed_products": {
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "product": {
                          "type": "string",
                          "enum": [
                            "forkop",
                            "prokop",
                            "podkop",
                            "tachyon"
                          ]
                        },
                        "version": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 60
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "packages": {
                          "maxItems": 20,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 80
                          }
                        }
                      },
                      "required": [
                        "product"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "last_error": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 500
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "health": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "service": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "capabilities": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "managed": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Принято",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "server_time": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/agent/v1/poll": {
      "post": {
        "summary": "Получить команду (long-poll)",
        "security": [
          {
            "agentToken": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Команда или null",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "command": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "op": {
                              "type": "string"
                            },
                            "args": {
                              "type": "object"
                            },
                            "expires_at": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "attempt": {
                              "type": "integer"
                            }
                          }
                        }
                      ]
                    },
                    "server_time": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/agent/v1/commands/{id}/result": {
      "post": {
        "summary": "Вернуть результат команды",
        "security": [
          {
            "agentToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "success",
                      "failed",
                      "cancelled",
                      "timeout"
                    ]
                  },
                  "result": {},
                  "error": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "maxLength": 80
                          },
                          "message": {
                            "type": "string",
                            "maxLength": 1000
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Результат принят"
          }
        }
      }
    },
    "/agent/v1/report": {
      "post": {
        "summary": "Загрузить диагностический отчёт",
        "security": [
          {
            "agentToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "quick",
                      "full"
                    ]
                  },
                  "product": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "agent_version": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4194304
                  },
                  "job_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "required": [
                  "kind",
                  "product",
                  "sha256",
                  "body"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Отчёт сохранён"
          }
        }
      }
    },
    "/agent/v1/rotate": {
      "post": {
        "summary": "Ротировать токен агента",
        "security": [
          {
            "agentToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Новый токен",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "agent_token": {
                      "type": "string"
                    },
                    "server_time": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
